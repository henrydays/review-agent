+def closest_sibling(path: str, tree: list[str], changed: set[str]) -> str | None:
+    """The existing file most like this one, by location and name. Comparing with it is how a careful reviewer finds what the new
+    code forgot: the delete rule, the validation, the registration that every other file of this kind has."""
+    target = Path(path)
+    tokens = set(re.findall(r"[a-z0-9]+", target.stem.lower()))
+    best, best_score = None, 0.0
+    for other in tree:
+        candidate = Path(other)
+        if other in changed or candidate.suffix != target.suffix or other == path:
+            continue
+        same_dir = candidate.parent == target.parent
+        if not (same_dir or candidate.parent.parent == target.parent.parent or candidate.parent.name == target.parent.name):
+            continue
+        words = set(re.findall(r"[a-z0-9]+", candidate.stem.lower()))
+        overlap = len(tokens & words) / len(tokens | words) if tokens | words else 0.0
+        score = (2.0 if same_dir else 1.0) + 2.0 * overlap + difflib.SequenceMatcher(None, target.stem.lower(), candidate.stem.lower()).ratio()
+        if score > best_score:
+            best, best_score = other, score
